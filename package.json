{
  "name": "skoda-transportation-ips-integration",
  "version": "1.0.0",
  "description": "Škoda Transportation IPS Integration",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "lint": "tsc --noEmit",
    "update-context": "node scripts/update-context.js",
    "prepare": "husky install",
    "db:migrate": "prisma migrate dev --name init",
    "db:generate": "prisma generate"
  },
  "keywords": [
    "skoda",
    "transportation",
    "ips",
    "maximo"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.4.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "fast-xml-parser": "^5.3.5",
    "multer": "^2.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.15.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/client": "^7.4.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.9.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "husky": "^8.0.0",
    "nodemon": "^3.1.7",
    "prisma": "^7.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

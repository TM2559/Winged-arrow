// Prisma schema for S1000D/S2000M Middleware
// PostgreSQL (Vercel-friendly with connection pooling)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model DataModule {
  id                Int               @id @default(autoincrement())
  dmCode            String            @unique // Full DMC string (e.g. "SKODA-A-...")
  techName          String?           // From <techName>
  issueDate         String?           // Stored as string
  xmlContent        String            // Entire raw XML body for viewer
  illustrationSvg   String?           // Optional inline SVG for hotspots (elements with id match internalRefId)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  maintenanceTasks  MaintenanceTask[]
}

model SparePart {
  id                Int               @id @default(autoincrement())
  partNumber        String            @unique
  name              String
  quantity          Int
  unit              String?
  maintenanceTasks  MaintenanceTask[]
}

// S3000L Maintenance Logic: Task -> Method (S1000D) -> Material (S2000M)
model MaintenanceTask {
  id          Int          @id @default(autoincrement())
  taskCode    String       @unique // e.g. "T-SKD-BR-001", "TASK-BRK-REPLACE"
  description String       // e.g. "Brake Pad Replacement"
  interval    String       // e.g. "10000 km" or "6 Months"
  personnel   String       // e.g. "Mechanic (Level 2)"
  duration    Float        // hours, e.g. 1.5
  dmId        Int?         // Link to S1000D Data Module (method)
  partId      Int?         // Link to S2000M Spare Part (material)
  dm          DataModule?  @relation(fields: [dmId], references: [id])
  part        SparePart?   @relation(fields: [partId], references: [id])
}

// Technician Feedback Loop: field reports linked to a manual (DMC)
model Feedback {
  id        Int      @id @default(autoincrement())
  dmCode    String   // Link to the manual (S1000D DMC)
  message   String   // The technician's comment
  status    String   @default("OPEN") // OPEN, RESOLVED
  createdAt DateTime @default(now())
}
